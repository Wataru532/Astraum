1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Astraum - space exploration simulator"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "Astraum"
            VALUE "OriginalFilename", "Astraum.exe"
            VALUE "ProductName", "Astraum"
            VALUE "ProductVersion", "1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
